# required
db_URL=
JWT_SECRET_KEY=

# optional
PORT=3000
JWT_EXPIRES_IN=7d
# allowed frontend origin(s), comma separated (all origins when empty)
CORS_ORIGIN=
FRONTEND_URL=

# Google sign-in through Auth0 (leave empty to disable)
secret=
baseURL=
clientID=
issuerBaseURL=

# PDF upload (Cloudinary)
cloud_name=
api_key=
api_secret=

# embeddings (Hugging Face access token)
HuggingFaceAccessKey=
